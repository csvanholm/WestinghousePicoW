            "serverpath": "${env:USERPROFILE}\\.pico-sdk\\openocd\\0.12.0+dev\\openocd.exe",
            "gdbPath": "${env:USERPROFILE}\\.pico-sdk\\toolchain\\15_2_Rel1\\bin\\arm-none-eabi-gdb.exe",
            "device": "RP2350",
            "searchDir": ["${env:USERPROFILE}\\.pico-sdk\\openocd\\0.12.0+dev\\scripts"],
            "configFiles": ["interface/cmsis-dap.cfg", "target/rp2350.cfg"],
            "svdFile": "${workspaceFolder}/third_party/pico-sdk/src/rp2350/hardware_regs/RP2350.svd",
            "runToEntryPoint": "main",
            "openOCDLaunchCommands": [
                "adapter speed 5000",
                "targets rp2350.cm0",
                "rp2350.cm0 configure -event gdb-attach { reset init }"
            ]
        },
